<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="depends,defects"
         requireCoverageMetadata="false"
         beStrictAboutCoverageMetadata="false"
         beStrictAboutOutputDuringTests="true"
         failOnRisky="true"
         failOnWarning="true">
    <!-- STRICTER-THAN-REFERENCE POSTURE (srphp review m9, disclosed
         2026-10-30): executionOrder="depends,defects",
         beStrictAboutOutputDuringTests, failOnRisky and failOnWarning are
         absent from the family reference (phlix-plugin-sample-theme/
         phpunit.xml). They are deliberate here: a warning-emitting or
         output-leaking test must not pass silently, and both CI legs (8.3
         and 8.4) run this file, so "green" means the same thing twice.
         The family standardization is owed UPWARD — reference and siblings
         should adopt this posture, not the reverse; until then this
         divergence is intentional, not accidental. -->
    <testsuites>
        <testsuite name="default">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>

    <!-- The CI job's "Upload coverage to Codacy" step reads ./coverage.xml, and
         the workflow comment states this file writes it. Before 2026-10-29 that
         claim was false: this file carried NO coverage-report configuration, so
         every plain `vendor/bin/phpunit` run (which is exactly how CI invokes
         it) collected nothing and wrote nothing, the upload step found no
         input, and `continue-on-error: true` masked it. The block below (ported
         from the family reference phlix-plugin-sample-theme/phpunit.xml) makes
         every run with a coverage driver present (CI installs pcov) emit the
         Cobertura report the upload step consumes. Verified 2026-10-29: with
         pcov loaded, a bare run writes coverage.xml; without any driver the
         block is inert and the suite stays green. -->
    <coverage>
        <report>
            <cobertura outputFile="coverage.xml"/>
        </report>
    </coverage>

    <php>
        <ini name="display_errors" value="1"/>
        <ini name="error_reporting" value="-1"/>
        <env name="XDEBUG_MODE" value="coverage"/>
    </php>
</phpunit>
