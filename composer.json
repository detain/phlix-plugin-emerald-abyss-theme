{
    "name": "detain/phlix-plugin-emerald-abyss-theme",
    "type": "phlix-plugin",
    "description": "Emerald Abyss — a deep oceanic ui-theme plugin for Phlix with teal accents.",
    "license": "MIT",
    "keywords": [
        "phlix",
        "phlix-plugin",
        "phlix-plugins",
        "ui-theme",
        "theme",
        "emerald-abyss",
        "dark-theme",
        "teal",
        "oceanic"
    ],
    "homepage": "https://github.com/detain/phlix-plugin-emerald-abyss-theme",
    "require": {
        "php": ">=8.3",
        "detain/phlix-shared": "^0.21",
        "psr/container": "^1.1 || ^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "repositories": [
        { "type": "vcs", "url": "https://github.com/detain/phlix-shared.git" }
    ],
    "autoload": {
        "psr-4": {
            "Phlix\\EmeraldAbyss\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phlix\\EmeraldAbyss\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon",
        "phpcs": "vendor/bin/phpcs --standard=phpcs.xml"
    }
}
